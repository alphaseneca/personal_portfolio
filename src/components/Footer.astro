---
/**
 * Footer Component
 * Clean, modern footer faithful to the portfolio's aesthetic.
 * Sourced dynamically from profile.json with social profiles and copyright.
 */
import profile from '../data/profile.json';

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-gray-200 dark:border-[#2d303d] mt-12 sm:mt-16 transition-colors">
  <div class="max-w-7xl 2xl:max-w-[1536px] mx-auto px-5 sm:px-8 md:px-12 py-8 sm:py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-5 sm:gap-6">
      
      <!-- Brand & Identity Column -->
      <div class="flex flex-col items-center sm:items-start text-center sm:text-left gap-0.5">
        <span class="font-heading font-bold text-lg sm:text-xl text-gray-900 dark:text-[#f1f3f9] tracking-tight transition-colors">
          {profile.name}
        </span>
        <p class="font-sans text-xs sm:text-sm font-medium text-gray-600 dark:text-gray-400 transition-colors">
          {profile.role}
        </p>
        <p class="font-mono text-[11px] text-gray-400 dark:text-gray-500 mt-0.5">
          © {currentYear} {profile.name}. All rights reserved.
        </p>
      </div>

      <!-- Right Column: Social Links -->
      <nav class="flex items-center gap-2" aria-label="Footer Social Links">
        {profile.socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.platform}
            class="w-8 h-8 rounded-full border border-gray-300 dark:border-[#353846] bg-white dark:bg-[#252834] flex items-center justify-center transition-all duration-300 hover:border-black dark:hover:border-neutral-300 hover:bg-gray-100 dark:hover:bg-[#303444] hover:scale-110 shadow-2xs shrink-0"
            title={social.platform}
          >
            <img
              src={social.icon}
              alt={social.platform}
              class="w-4 h-4 object-contain grayscale opacity-80 hover:grayscale-0 hover:opacity-100 dark:invert dark:opacity-85 transition-all"
              loading="lazy"
            />
          </a>
        ))}
      </nav>

    </div>
  </div>
</footer>
